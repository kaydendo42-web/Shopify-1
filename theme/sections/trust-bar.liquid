<div class="trust-bar">
  <div class="container">
    <div class="trust-bar__track">
      {%- for block in section.blocks -%}
        <div class="trust-bar__item">
          <span class="trust-bar__icon">
            <svg class="icon icon-checkmark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <!-- Fallback standard trust badges -->
        <div class="trust-bar__item">
          <span class="trust-bar__icon">✓</span>
          <span>Risk-Free 30-Day Guarantee</span>
        </div>
        <div class="trust-bar__item">
          <span class="trust-bar__icon">✓</span>
          <span>Free Express Shipping</span>
        </div>
        <div class="trust-bar__item">
          <span class="trust-bar__icon">✓</span>
          <span>24/7 Customer Support</span>
        </div>
        <div class="trust-bar__item">
          <span class="trust-bar__icon">✓</span>
          <span>SSL Secure Checkout</span>
        </div>
        <div class="trust-bar__item">
          <span class="trust-bar__icon">✓</span>
          <span>1-Year Product Warranty</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge label",
          "default": "Risk-Free 30-Day Guarantee"
        }
      ]
    }
  ]
}
{% endschema %}
