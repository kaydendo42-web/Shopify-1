<section class="section comparison" style="background-color: var(--color-bg-alt);">
  <div class="container container--narrow">
    <div class="text-center" style="margin-bottom: var(--sp-6);">
      {%- if section.settings.subheading != blank -%}
        <span style="font-size: var(--fs-sm); font-weight: 700; text-transform: uppercase; color: var(--color-accent); letter-spacing: 0.05em;">{{ section.settings.subheading }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 style="margin-top: var(--sp-2);">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="comparison__wrapper">
      <table class="comparison__table">
        <thead>
          <tr>
            <th class="comparison__th comparison__th--first">Core Feature</th>
            <th class="comparison__th comparison__th--brand">{{ shop.name | default: 'Our Brand' }}</th>
            <th class="comparison__th">Alternatives / Knock-offs</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr>
              <td class="comparison__td comparison__td--first">{{ block.settings.feature_name }}</td>
              <td class="comparison__td comparison__td--brand">
                {%- if block.settings.us_supported -%}
                  <span class="comparison__icon--yes">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                {%- else -%}
                  <span class="comparison__icon--no">✕</span>
                {%- endif -%}
              </td>
              <td class="comparison__td">
                {%- if block.settings.them_supported -%}
                  <span class="comparison__icon--yes" style="color: var(--color-text-muted);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                {%- else -%}
                  <span class="comparison__icon--no">✕</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}

          {%- if section.blocks.size == 0 -%}
            <!-- Fallback rows for preview -->
            <tr>
              <td class="comparison__td comparison__td--first">Pure Copper High-Speed Motor</td>
              <td class="comparison__td comparison__td--brand"><span class="comparison__icon--yes">✓</span></td>
              <td class="comparison__td"><span class="comparison__icon--no">✕</span></td>
            </tr>
            <tr>
              <td class="comparison__td comparison__td--first">Ultra-Sharp Japanese Stainless Steel Blades</td>
              <td class="comparison__td comparison__td--brand"><span class="comparison__icon--yes">✓</span></td>
              <td class="comparison__td"><span class="comparison__icon--no">✕</span></td>
            </tr>
            <tr>
              <td class="comparison__td comparison__td--first">Leak-Proof Security Lock Mechanism</td>
              <td class="comparison__td comparison__td--brand"><span class="comparison__icon--yes">✓</span></td>
              <td class="comparison__td"><span class="comparison__icon--no">✕</span></td>
            </tr>
            <tr>
              <td class="comparison__td comparison__td--first">Dishwasher Safe & Self-Cleaning</td>
              <td class="comparison__td comparison__td--brand"><span class="comparison__icon--yes">✓</span></td>
              <td class="comparison__td"><span class="comparison__icon--no">✕</span></td>
            </tr>
            <tr>
              <td class="comparison__td comparison__td--first">Risk-Free 30-Day Refund Guarantee</td>
              <td class="comparison__td comparison__td--brand"><span class="comparison__icon--yes">✓</span></td>
              <td class="comparison__td"><span class="comparison__icon--no">✕</span></td>
            </tr>
          {%- endif -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "US VS OTHERS"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature Name",
          "default": "Feature description"
        },
        {
          "type": "checkbox",
          "id": "us_supported",
          "label": "Supported by us",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "them_supported",
          "label": "Supported by competitors",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
