{%- assign default_videos = 'ugc-1.mp4,ugc-2.mp4,ugc-3.mp4' | split: ',' -%}

<section class="section ugc-videos" aria-label="Real customers using The Quiet Hour">
  <div class="container">
    <header class="ugc-videos__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ugc-videos__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ugc-videos__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.sub != blank -%}
        <p class="ugc-videos__sub">{{ section.settings.sub }}</p>
      {%- endif -%}
    </header>

    <div class="ugc-videos__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign src_url = '' -%}
          {%- if block.settings.video_file != blank -%}
            {%- assign src_url = block.settings.video_file.sources | where: 'format', 'mp4' | first | map: 'url' | first -%}
          {%- elsif block.settings.video_asset != blank -%}
            {%- assign src_url = block.settings.video_asset | asset_url -%}
          {%- endif -%}

          {%- if src_url != blank -%}
            <figure class="ugc-card" {{ block.shopify_attributes }}>
              <div class="ugc-card__media">
                <video class="ugc-card__video"
                  src="{{ src_url }}"
                  {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 600 }}"{% endif %}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  data-ugc-video></video>
                <button class="ugc-card__play" aria-label="Play / pause">
                  <svg class="ugc-card__play-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </button>
                <button class="ugc-card__mute" aria-label="Toggle sound" data-ugc-mute>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-mute-icon><path d="M5 9h4l5-4v14l-5-4H5z"/><line x1="17" y1="9" x2="22" y2="14"/><line x1="22" y1="9" x2="17" y2="14"/></svg>
                </button>
              </div>
              {%- if block.settings.caption != blank -%}
                <figcaption class="ugc-card__caption">
                  <span class="ugc-card__name">{{ block.settings.name }}</span>
                  <span class="ugc-card__quote">"{{ block.settings.caption }}"</span>
                </figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for video in default_videos -%}
          <figure class="ugc-card">
            <div class="ugc-card__media">
              <video class="ugc-card__video"
                src="{{ video | asset_url }}"
                muted loop playsinline preload="metadata" data-ugc-video></video>
              <button class="ugc-card__play" aria-label="Play / pause">
                <svg class="ugc-card__play-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <button class="ugc-card__mute" aria-label="Toggle sound" data-ugc-mute>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-mute-icon><path d="M5 9h4l5-4v14l-5-4H5z"/><line x1="17" y1="9" x2="22" y2="14"/><line x1="22" y1="9" x2="17" y2="14"/></svg>
              </button>
            </div>
          </figure>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC Videos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REAL RITUALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn by women in the phase" },
    { "type": "textarea", "id": "sub", "label": "Sub-heading", "default": "Ten minutes. Three nights a week. From the women who've kept it." }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video_file", "label": "Video (recommended)" },
        { "type": "text", "id": "video_asset", "label": "OR asset filename in /assets (e.g. ugc-1.mp4)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Anna, 47" },
        { "type": "textarea", "id": "caption", "label": "Caption / quote" }
      ]
    }
  ],
  "presets": [
    { "name": "UGC Videos", "category": "Social proof" }
  ]
}
{% endschema %}
