<footer class="site-footer">
  <div class="container footer__container">
    <div class="footer__grid">
      <!-- About / Brand Info -->
      <div class="footer__column">
        <h3 class="footer__title">{{ shop.name }}</h3>
        <p class="footer__text">{{ section.settings.about_text }}</p>
        {%- if section.settings.show_contact_email -%}
          <p class="footer__text"><strong>Contact:</strong> <a href="mailto:{{ section.settings.contact_email }}" class="footer__link">{{ section.settings.contact_email }}</a></p>
        {%- endif -%}
      </div>

      <!-- Links -->
      <div class="footer__column">
        <h4 class="footer__title">Quick Links</h4>
        <ul class="footer__links">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="footer__column">
        <h4 class="footer__title">Join Our Newsletter</h4>
        <p class="footer__text">Subscribe for exclusive sales, product launches, and tips.</p>
        {%- form 'customer', class: 'footer__newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="footer__input"
            value="{{ form.email }}"
            placeholder="Enter your email"
            aria-label="Email address"
            required
          >
          <button type="submit" class="btn btn--primary footer__newsletter-btn">Subscribe</button>
        {%- endform -%}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <div class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </div>
      
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-badge' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "We bring you high-quality, outcome-based products that solve real everyday problems. Customer satisfaction is our #1 priority."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "support@example.com"
    },
    {
      "type": "checkbox",
      "id": "show_contact_email",
      "label": "Show contact email",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
