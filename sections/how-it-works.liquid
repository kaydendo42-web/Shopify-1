<section class="section how-it-works" style="background-color: var(--color-bg);">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="text-center" style="margin-bottom: var(--sp-6);">
        {%- if section.settings.subheading != blank -%}
          <span style="font-size: var(--fs-sm); font-weight: 700; text-transform: uppercase; color: var(--color-accent); letter-spacing: 0.05em;">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="margin-top: var(--sp-2);">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="how-it-works__steps">
      {%- for block in section.blocks -%}
        <div class="how-it-works__step">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: class: 'how-it-works__img', alt: block.settings.title }}
          {%- else -%}
            {%- assign ritual_fallbacks = 'ritual-step-1.jpeg,ritual-step-2.jpeg,ritual-step-3.jpeg' | split: ',' -%}
            {%- assign fallback_src = ritual_fallbacks[forloop.index0] -%}
            {%- if fallback_src != blank -%}
              <img src="{{ fallback_src | asset_url }}" class="how-it-works__img" alt="{{ block.settings.title }}" loading="lazy" width="400" height="400">
            {%- else -%}
              <div class="how-it-works__img" style="display:flex; align-items:center; justify-content:center; background-color: var(--color-bg-alt); color: var(--color-text-muted);">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </div>
            {%- endif -%}
          {%- endif -%}
          
          <div class="how-it-works__num">{{ forloop.index }}</div>
          <h3 class="how-it-works__heading">{{ block.settings.title }}</h3>
          <p class="how-it-works__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <!-- Fallback 3 steps -->
        <div class="how-it-works__step">
          <div class="how-it-works__img" style="display:flex; align-items:center; justify-content:center; background-color: var(--color-bg-alt);">📦</div>
          <div class="how-it-works__num">1</div>
          <h3 class="how-it-works__heading">Choose Your Package</h3>
          <p class="how-it-works__text">Select your preferred bundle pack above. The more you buy, the more you save.</p>
        </div>
        <div class="how-it-works__step">
          <div class="how-it-works__img" style="display:flex; align-items:center; justify-content:center; background-color: var(--color-bg-alt);">🚚</div>
          <div class="how-it-works__num">2</div>
          <h3 class="how-it-works__heading">Free Express Delivery</h3>
          <p class="how-it-works__text">We ship from our local warehouse in 1-3 business days. Tracking details sent immediately.</p>
        </div>
        <div class="how-it-works__step">
          <div class="how-it-works__img" style="display:flex; align-items:center; justify-content:center; background-color: var(--color-bg-alt);">🌟</div>
          <div class="how-it-works__num">3</div>
          <h3 class="how-it-works__heading">Enjoy Outcomes</h3>
          <p class="how-it-works__text">Start experiencing the life-changing outcomes immediately. Backed by our 30-day guarantee.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Started in 3 Easy Steps"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "PROCESS FLOW"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Select Package"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Description",
          "default": "Select your quantity and benefits above."
        }
      ]
    }
  ]
}
{% endschema %}
