<section class="section founder-note">
  <div class="container">
    <header class="founder-note__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="founder-note__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="founder-note__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>

    <div class="founder-note__grid">
      <div class="founder-note__portrait">
        {%- if section.settings.portrait != blank -%}
          {{ section.settings.portrait | image_url: width: 800 | image_tag:
            class: 'founder-note__img',
            loading: 'lazy',
            widths: '400, 600, 800, 1000',
            sizes: '(min-width: 768px) 40vw, 80vw',
            alt: section.settings.founder_name | default: 'Founder portrait'
          }}
        {%- else -%}
          <img class="founder-note__img"
               src="{{ 'woman-mirror-2.jpg' | asset_url }}"
               width="800" height="800" loading="lazy"
               alt="{{ section.settings.founder_name | default: 'Founder portrait' }}">
        {%- endif -%}
        {%- if section.settings.caption != blank -%}
          <p class="founder-note__caption">{{ section.settings.caption }}</p>
        {%- endif -%}
      </div>

      <div class="founder-note__body">
        <div class="founder-note__rule"></div>
        {%- if section.settings.lead != blank -%}
          <p class="founder-note__lead">{{ section.settings.lead }}</p>
        {%- endif -%}
        <blockquote class="founder-note__quote">{{ section.settings.quote }}</blockquote>
        <p class="founder-note__signoff">
          <span class="founder-note__signoff-name">— {{ section.settings.founder_name | default: 'The Founder' }}</span>
          {%- if section.settings.founder_role != blank -%}
            <span class="founder-note__signoff-role">{{ section.settings.founder_role }}</span>
          {%- endif -%}
        </p>
        {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn--outline founder-note__cta">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Note",
  "settings": [
    { "type": "text",  "id": "eyebrow", "label": "Eyebrow", "default": "A NOTE FROM THE FOUNDER" },
    { "type": "text",  "id": "heading", "label": "Heading", "default": "Built by a woman in the same phase as you." },
    { "type": "header", "content": "Portrait" },
    { "type": "image_picker", "id": "portrait", "label": "Founder portrait" },
    { "type": "text",  "id": "caption", "label": "Portrait caption", "default": "The Quiet Hour HQ · Sydney" },
    { "type": "header", "content": "Body" },
    { "type": "text", "id": "lead", "label": "Lead line", "default": "I'm 47. I built this because nothing in the chemist worked anymore." },
    { "type": "richtext", "id": "quote", "label": "Quote (richtext)", "default": "<p>I'd spent over $4,000 on serums in two years and watched my face change anyway. I started reading the actual research on red light, found the wavelengths that mattered, and built a mask designed for the phase the rest of the industry pretends isn't happening.</p><p>This is for any woman who's tired of being marketed to like she's 22 — or like she's done.</p>" },
    { "type": "text", "id": "founder_name", "label": "Founder name", "default": "Founder, The Quiet Hour" },
    { "type": "text", "id": "founder_role", "label": "Founder role / location", "default": "Sydney, Australia" },
    { "type": "header", "content": "Optional CTA" },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_url", "label": "Button URL" }
  ],
  "presets": [{ "name": "Founder Note" }]
}
{% endschema %}
