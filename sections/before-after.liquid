{%- liquid
  assign heading = section.settings.heading | default: 'See the difference'
  assign eyebrow = section.settings.eyebrow | default: 'BEFORE / AFTER'
  assign sub = section.settings.sub | default: 'Real customers. Real consistency. Photos taken at the same time of day, same lighting, no filters.'
-%}

<section class="section before-after-section">
  <div class="container">
    <header class="before-after__header">
      <span class="before-after__eyebrow">{{ eyebrow }}</span>
      <h2 class="before-after__heading">{{ heading }}</h2>
      <p class="before-after__sub">{{ sub }}</p>
    </header>

    {%- if section.settings.pair_image != blank or section.settings.show_default_pair -%}
      <figure class="ba-pair">
        {%- if section.settings.pair_image != blank -%}
          {{ section.settings.pair_image | image_url: width: 1600 | image_tag:
            class: 'ba-pair__img',
            loading: 'lazy',
            widths: '800, 1200, 1600',
            sizes: '(min-width: 990px) 90vw, 100vw',
            alt: 'Before and after at 6 weeks'
          }}
        {%- else -%}
          <img class="ba-pair__img" src="{{ 'before-after-pair.jpg' | asset_url }}" width="1600" height="900" loading="lazy" alt="Before and after at 6 weeks">
        {%- endif -%}
        <figcaption class="ba-pair__caption">
          <span class="ba-pair__tag">Real customer · 6-week comparison · same lighting, no filters</span>
        </figcaption>
      </figure>
    {%- endif -%}

    <div class="before-after__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'comparison' -%}
          <figure class="ba-card" {{ block.shopify_attributes }}>
            <div class="ba-static">
              {%- assign ba_img = block.settings.after_image | default: block.settings.before_image -%}
              {%- if ba_img != blank -%}
                {{ ba_img | image_url: width: 1600 | image_tag:
                  class: 'ba-static__img',
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  alt: block.settings.label | default: 'Before and after comparison'
                }}
              {%- else -%}
                <img class="ba-static__img" src="{{ 'before-after-2.jpg' | asset_url }}" width="1200" height="1500" loading="lazy" alt="Before and after comparison">
              {%- endif -%}
            </div>

            <figcaption class="ba-card__caption">
              <div class="ba-card__meta">
                <strong>{{ block.settings.customer_name }}</strong>
                {%- if block.settings.customer_age %} — {{ block.settings.customer_age }}{%- endif -%}
              </div>
              {%- if block.settings.duration -%}
                <span class="ba-card__duration">{{ block.settings.duration }}</span>
              {%- endif -%}
              {%- if block.settings.note -%}
                <p class="ba-card__note">"{{ block.settings.note }}"</p>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <figure class="ba-card">
          <div class="ba-static">
            <div class="ba-static__img ba-static__img--placeholder">Before / After</div>
          </div>
          <figcaption class="ba-card__caption">
            <div class="ba-card__meta"><strong>Add a Comparison block</strong></div>
            <p class="ba-card__note">Upload a before/after image in the theme editor.</p>
          </figcaption>
        </figure>
      {%- endif -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="before-after__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Before / After",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BEFORE / AFTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Real customers. Real consistency. Photos at the same time of day, same lighting, no filters." },
    { "type": "header", "content": "Hero pair image (side-by-side)" },
    { "type": "image_picker", "id": "pair_image", "label": "Pair image (single image with before+after side-by-side)" },
    { "type": "checkbox", "id": "show_default_pair", "label": "Show built-in derma comparison if no image uploaded", "default": true },
    { "type": "header", "content": "Footer" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer footnote", "default": "Individual results vary. Photos taken at week 0 and week 8 of consistent use (3 nights/week, ~25 sessions)." }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "Before/After Comparison",
      "settings": [
        { "type": "image_picker", "id": "before_image", "label": "Before image" },
        { "type": "image_picker", "id": "after_image", "label": "After image" },
        { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Anna K." },
        { "type": "text", "id": "customer_age", "label": "Customer age + city", "default": "47, Sydney" },
        { "type": "text", "id": "duration", "label": "Duration shown", "default": "8 weeks" },
        { "type": "textarea", "id": "note", "label": "Customer note" }
      ]
    }
  ],
  "presets": [
    { "name": "Before / After" }
  ]
}
{% endschema %}
