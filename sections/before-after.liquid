{%- liquid
  assign heading = section.settings.heading | default: 'See the difference'
  assign eyebrow = section.settings.eyebrow | default: 'BEFORE / AFTER'
  assign sub = section.settings.sub | default: 'Real customers. Real consistency. Photos taken at the same time of day, same lighting, no filters.'
-%}

<section class="section before-after-section">
  <div class="container">
    <header class="before-after__header">
      <span class="before-after__eyebrow">{{ eyebrow }}</span>
      <h2 class="before-after__heading">{{ heading }}</h2>
      <p class="before-after__sub">{{ sub }}</p>
    </header>

    <div class="before-after__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'comparison' -%}
          <figure class="ba-card" {{ block.shopify_attributes }}>
            <div class="ba-slider"
                 data-ba-slider
                 role="figure"
                 aria-label="{{ block.settings.label | default: 'Before and after comparison' }}">

              <div class="ba-slider__before">
                {%- if block.settings.before_image != blank -%}
                  {{ block.settings.before_image | image_url: width: 1200 | image_tag:
                    class: 'ba-slider__img',
                    loading: 'lazy',
                    widths: '600, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: 'Before'
                  }}
                {%- else -%}
                  <img class="ba-slider__img" src="{{ 'before-after-1.jpg' | asset_url }}" width="1200" height="1500" loading="lazy" alt="Before">
                {%- endif -%}
                <span class="ba-slider__tag ba-slider__tag--before">Before</span>
              </div>

              <div class="ba-slider__after" data-ba-after>
                {%- if block.settings.after_image != blank -%}
                  {{ block.settings.after_image | image_url: width: 1200 | image_tag:
                    class: 'ba-slider__img',
                    loading: 'lazy',
                    widths: '600, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: 'After'
                  }}
                {%- else -%}
                  <img class="ba-slider__img" src="{{ 'before-after-2.jpg' | asset_url }}" width="1200" height="1500" loading="lazy" alt="After">
                {%- endif -%}
                <span class="ba-slider__tag ba-slider__tag--after">After</span>
              </div>

              <button type="button" class="ba-slider__handle" data-ba-handle aria-label="Drag to compare">
                <span class="ba-slider__handle-line"></span>
                <span class="ba-slider__handle-grip">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                    <polyline points="9 6 15 12 9 18" transform="translate(6 0)"/>
                  </svg>
                </span>
              </button>
            </div>

            <figcaption class="ba-card__caption">
              <div class="ba-card__meta">
                <strong>{{ block.settings.customer_name }}</strong>
                {%- if block.settings.customer_age %} — {{ block.settings.customer_age }}{%- endif -%}
              </div>
              {%- if block.settings.duration -%}
                <span class="ba-card__duration">{{ block.settings.duration }}</span>
              {%- endif -%}
              {%- if block.settings.note -%}
                <p class="ba-card__note">"{{ block.settings.note }}"</p>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <figure class="ba-card">
          <div class="ba-slider" data-ba-slider>
            <div class="ba-slider__before">
              <div class="ba-slider__img ba-slider__img--placeholder ba-slider__img--before-ph">Before</div>
              <span class="ba-slider__tag ba-slider__tag--before">Before</span>
            </div>
            <div class="ba-slider__after" data-ba-after>
              <div class="ba-slider__img ba-slider__img--placeholder ba-slider__img--after-ph">After</div>
              <span class="ba-slider__tag ba-slider__tag--after">After</span>
            </div>
            <button type="button" class="ba-slider__handle" data-ba-handle aria-label="Drag to compare">
              <span class="ba-slider__handle-line"></span>
              <span class="ba-slider__handle-grip">‹›</span>
            </button>
          </div>
          <figcaption class="ba-card__caption">
            <div class="ba-card__meta"><strong>Add a Comparison block</strong></div>
            <p class="ba-card__note">Upload before / after photos in the theme editor.</p>
          </figcaption>
        </figure>
      {%- endif -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="before-after__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Before / After",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BEFORE / AFTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Real customers. Real consistency. Photos at the same time of day, same lighting, no filters." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer footnote", "default": "Individual results vary. Photos taken at week 0 and week 8 of consistent use (3 nights/week, ~25 sessions)." }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "Before/After Comparison",
      "settings": [
        { "type": "image_picker", "id": "before_image", "label": "Before image" },
        { "type": "image_picker", "id": "after_image", "label": "After image" },
        { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Anna K." },
        { "type": "text", "id": "customer_age", "label": "Customer age + city", "default": "47, Sydney" },
        { "type": "text", "id": "duration", "label": "Duration shown", "default": "8 weeks" },
        { "type": "textarea", "id": "note", "label": "Customer note" }
      ]
    }
  ],
  "presets": [
    { "name": "Before / After" }
  ]
}
{% endschema %}
