<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical, base, and theme CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% # Favicon %}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    
    {% # Custom interactions script %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    <!-- Cart Drawer -->
    <div id="cart-drawer-overlay" class="cart-drawer-overlay" aria-hidden="true"></div>

    <div id="cart-drawer" class="cart-drawer" aria-hidden="true" role="dialog" aria-label="Your bag">
      <div class="cart-drawer__inner">

        <div class="cart-drawer__header">
          <div class="cart-drawer__title-wrap">
            <h2 class="cart-drawer__title">Your ritual</h2>
            <span class="cart-drawer__count-pill"><span id="cart-drawer-count">0</span> items</span>
          </div>
          <button class="cart-drawer__close" aria-label="Close bag" data-close-drawer>
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M5 5l12 12M17 5L5 17"/>
            </svg>
          </button>
        </div>

        <div class="free-ship cart-drawer__freeship" data-threshold="{{ settings.free_shipping_threshold | default: 99 | times: 100 }}">
          <p class="free-ship__text" id="cart-drawer-ship-text">Add items to unlock free AU-wide shipping.</p>
          <div class="free-ship__bar"><span class="free-ship__bar-fill" id="cart-drawer-ship-fill" style="width:0%"></span></div>
        </div>

        <div class="cart-drawer__lines" id="cart-drawer-lines">
          <div class="cart-drawer__empty">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <path d="M3 6h18l-2 13H5L3 6z"/><path d="M8 6V4a4 4 0 0 1 8 0v2"/>
            </svg>
            <p>Your bag is quiet.</p>
            <button class="cart-drawer__empty-btn" data-close-drawer>Start your ritual →</button>
          </div>
        </div>

        <div class="cart-drawer__footer">
          <div class="cart-drawer__savings" id="cart-drawer-savings" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 12l-8 8-8-8M12 20V4"/></svg>
            You're saving <strong data-savings-amount>$0.00</strong> today
          </div>

          <div class="cart-drawer__subtotal">
            <div class="cart-drawer__subtotal-label">
              <span>Subtotal</span>
              <span class="cart-drawer__subtotal-note">Shipping &amp; taxes calculated at checkout</span>
            </div>
            <span class="cart-drawer__subtotal-amount" id="cart-drawer-subtotal">$0.00</span>
          </div>

          <a href="/checkout" class="btn btn--primary cart-drawer__checkout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
            </svg>
            Secure checkout
          </a>

          <div class="cart-drawer__trust">
            <span class="cart-drawer__trust-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/></svg>
              60-night trial
            </span>
            <span class="cart-drawer__trust-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
              Ships from Sydney in 24 hrs
            </span>
          </div>

          <div class="cart-drawer__payments" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'cart-drawer__payment-icon' }}
            {%- endfor -%}
          </div>

          <div class="cart-drawer__rating">
            <span aria-hidden="true">★★★★★</span>
            <span>4.9 from 847 women in the phase</span>
          </div>

          <button class="cart-drawer__continue" data-close-drawer>Keep browsing</button>
        </div>

      </div>
    </div>

  </body>
</html>
